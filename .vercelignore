# Vercel ignore file
# Files and directories to exclude from deployment

# Environment files (use Vercel environment variables instead)
.env
.env.local
.env.development
.env.production
.env*.local

# Dependencies
node_modules
.pnp
.pnp.js

# Testing
coverage
.nyc_output

# Next.js
.next
out
build
dist

# Misc
.DS_Store
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode
.idea
*.swp
*.swo
*~

# Documentation (optional - remove if you want docs deployed)
*.md
!README.md

# Scripts (optional - remove if you need scripts in deployment)
*.sh

# Backend (should be deployed separately)
Backend/
